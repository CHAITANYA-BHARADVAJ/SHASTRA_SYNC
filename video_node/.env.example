# Copy this file to `.env` and edit as needed.
# Real environment variables always override values in .env.

# Teammate 1's Core API (the Hub).
#   Local dev : http://localhost:8000
#   Hosted    : https://shastra-sync.onrender.com
API_URL=http://localhost:8000

# Which elder this camera is watching.
ELDER_ID=elder_001

# Webcam device index passed to cv2.VideoCapture().
CAMERA_INDEX=0

# Seconds to suppress duplicate events of the same type, so the Hub is not
# spammed ~30x/second while a fall is ongoing.
EVENT_COOLDOWN_SECONDS=10

# Networking. Keep the timeout generous: a free-tier host can cold-start
# for 50s+, and a short timeout would drop the first fall after idle.
HTTP_TIMEOUT=60
EVENT_MAX_RETRIES=3
EVENT_RETRY_BACKOFF=1

# --- Detection tuning (optional) ---
FALL_TORSO_ANGLE_DEG=55
FALL_DROP_VELOCITY=0.35
POSE_MIN_VISIBILITY=0.5
EMOTION_ANALYZE_EVERY_N_FRAMES=30
EMOTION_SUSTAINED_SECONDS=4

# --- Emotion accuracy refinements (optional) ---
# Reduce false distress alerts. All make the "sad/fear" rule more reliable
# without changing the event that gets sent.
#
# Require DeepFace to actually locate a face before trusting the emotion
# (1 = on, 0 = off). Prevents phantom "sad" reads when nobody is in frame.
EMOTION_REQUIRE_FACE=1
# Minimum face-detector confidence (0..1) for a face to count as present.
EMOTION_MIN_FACE_CONFIDENCE=0.55
# Minimum emotion score (0..1) before a distress label is trusted.
EMOTION_MIN_CONFIDENCE=0.45
# Rolling vote: of the last EMOTION_WINDOW analyses, at least
# EMOTION_VOTE_RATIO must be distress before firing (tolerates flicker).
EMOTION_WINDOW=5
EMOTION_VOTE_RATIO=0.6
