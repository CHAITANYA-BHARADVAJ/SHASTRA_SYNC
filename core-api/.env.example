# Copy this file to `.env` and adjust as needed.

# PostgreSQL connection string (production / normal local dev).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shastra_sync

# Hackathon fallback: set to 1 to use a local SQLite file instead of PostgreSQL
# (no database server required). Leave unset/0 to use DATABASE_URL above.
USE_SQLITE=0
