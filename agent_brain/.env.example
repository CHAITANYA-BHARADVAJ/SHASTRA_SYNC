# ==========================================================================
# SHASTRA SYNC - Teammate 2 (The AI Brain) Configuration
# Copy this file to ".env" and fill in your values.
# ==========================================================================

# --- The Hub (Teammate 1) ---
# Base URL of the Core API. Do NOT include a trailing slash.
API_URL=http://localhost:8000

# --- LLM Provider Selection ---
# Which provider to use: "openai" | "openrouter" | "groq".
#   - groq:       FAST + free tier (recommended). Key: https://console.groq.com/keys
#   - openai:     Uses OpenAI's gpt-4o. Requires a PAID OpenAI account with credits.
#   - openrouter: FREE models via OpenRouter. Key: https://openrouter.ai/keys
LLM_PROVIDER=groq

# --- Groq (fast, free tier) ---
# Create a key at https://console.groq.com/keys  (starts with "gsk_")
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# --- OpenAI (paid) ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# --- OpenRouter (has a free tier) ---
# Sign up (free) and create a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
# Comma-separated list of FREE models (":free" = $0). The agent tries them in
# order and automatically falls back to the next if one is busy/unavailable.
# Note: free models come and go. See the current list at
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=z-ai/glm-5.2:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,minimax/minimax-m3:free,nvidia/nemotron-3-super-120b-a12b:free

# --- Agent tuning ---
# How often (seconds) to poll the Hub for pending events.
POLL_INTERVAL_SECONDS=2
